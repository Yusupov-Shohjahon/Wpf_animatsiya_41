<Window x:Class="Wpf_animatsiya_41.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_animatsiya_41"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
      Loaded="Windows_Loaded"
        >
    <Grid>
        <StackPanel Orientation="Horizontal">
            <StackPanel Width="200">
                <StackPanel Height="300">
                    <Image x:Name="Image"  Width="100" Height="100" Source="/jpt2.jpg" 
                 Margin="0,100,0,20" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                        </Image.RenderTransform>
                    </Image>
                </StackPanel>
                <StackPanel>
                    <Button Height="70" Content="Animatsiya" 
                           FontSize="24"
                            Click="Kattalashtirish_Animatsiyasi"/>

                </StackPanel>
            </StackPanel>
            <StackPanel>
                <StackPanel Height="100">
                    <Canvas>
                        <TextBlock Text="Assalomu alaykum" x:Name="Matn" 
            FontSize="22" FontWeight="Bold"
            Margin="0 10 0 0"/>

                    </Canvas>
                </StackPanel>
                <StackPanel>
                    <Rectangle x:Name="Tortburchak" Width="300" Height="200" RadiusX="0" RadiusY="0"
       Margin="50 100">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="Red"/>
                                <GradientStop Offset="1" Color="Yellow"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>

            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
